    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@types/bytes": "^3.1.6",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "oxlint": "^1.83.0",
    "semantic-release": "^25.0.9",
    "semantic-release-major-tag": "^0.3.2",
    "tsdown": "^0.21.10",
